{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"noEmit": false,
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["test/**/*.ts", "test/**/*.tsx"]
}
