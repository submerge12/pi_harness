{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node", "vitest"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
